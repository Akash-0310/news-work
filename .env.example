########################################
# NewsFlow — environment configuration
# Copy to .env and fill in real values.
# NEVER commit .env
########################################

# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Public URL of the React app (used for CORS + cookie domain)
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Local dev via docker compose (see docker-compose.yml)
DATABASE_URL=postgresql://newsflow:newsflow@localhost:5432/newsflow?schema=public

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---------- News providers ----------
# All provider keys are SERVER-SIDE ONLY. Never expose to the frontend.
# Every provider is optional: the app runs on seed data + RSS with no keys at all.
NEWS_API_KEY=
WORLD_NEWS_API_KEY=
APITUBE_API_KEY=
SPORTS_API_KEY=
GNEWS_API_KEY=

# Comma-separated list of providers to enable.
# Available: rss, worldnews, newsapi, apitube, sports
ENABLED_PROVIDERS=rss

# ---------- Ingestion tuning ----------
# Cron expression for the recurring fetch job (default: every 10 minutes)
NEWS_FETCH_CRON=*/10 * * * *
TRENDING_CRON=*/5 * * * *
CLEANUP_CRON=0 3 * * *
ARTICLE_RETENTION_DAYS=45
INGEST_BATCH_SIZE=100

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# ---------- Cache TTLs (seconds) ----------
CACHE_TTL_LATEST=120
CACHE_TTL_TRENDING=120
CACHE_TTL_CATEGORY=300
CACHE_TTL_SEARCH=180
CACHE_TTL_ARTICLE=600

# ---------- AI (optional, future) ----------
# Leave empty to disable AI features entirely — the app must not depend on them.
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ---------- Frontend (Vite) ----------
# Only VITE_* vars reach the browser bundle. Never put a secret here.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_WS_URL=ws://localhost:4000
